# Use a dedicated Neon development branch/database. Migrations require the direct (unpooled) URL.
NEON_BRANCH=sauti-dev
DATABASE_URL=postgresql://USER:PASSWORD@DEV-HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DEV-HOST/DB?sslmode=require

# Paystack secret key and webhook signing secret. Never use frontend/public keys here.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_with_webhook_signing_secret
PAYMENT_TOKEN_SECRET=replace_with_random_secret_of_at_least_32_characters

# Optional absolute URL registered as the Paystack transaction return URL.
PAYSTACK_CALLBACK_URL=https://your-host.example/#/review
PORT=3000
